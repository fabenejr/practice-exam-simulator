{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-bank.schema.json",
  "title": "Question bank (schema version 1)",
  "description": "Format of a question bank importable by the simulator. The authoritative checks live in js/core.js (validateBank); this schema is for editors and documentation.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "domains", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "language": { "type": "string", "description": "BCP 47 tag of the questions, e.g. en or pt-BR." },
    "author": { "type": "string" },
    "license": { "type": "string", "description": "License of the questions, e.g. MIT or CC-BY-4.0." },
    "source": { "type": "string", "description": "Where the questions come from (URL or citation)." },
    "passThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.75 },
    "timeLimitMinutes": { "type": "integer", "minimum": 0, "maximum": 600, "description": "Suggested time for exam mode; 0 means no limit." },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "type", "question", "options", "answer"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "description": "Must match a domain id." },
          "type": { "enum": ["single", "multiple"] },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "answer": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Ids of the correct options. One for single; two or more (fewer than all options) for multiple."
          },
          "explanation": { "type": "string" }
        }
      }
    }
  }
}
